# 构建与运行时产物
.build/
.upstream/
node_modules/
gateway/node_modules/
.pnpm-store/
tmp/

# 本地数据卷（容器挂载点，不入库）
data/
workspace/

# 日志与缓存
*.log
.cache/
npm-debug.log*

# 本地环境配置与私密凭据
.env
.env.local
*.pem
*.key

# 规则与私有规划文档（严禁上传 GitHub，本地私有）
PROJECT_RULES.md
RULES.md
*RULES.md
PROJECT_PLAN.md
*PLAN.md
REMOTE_DEBUG.md
*DEBUG.md

# 验证与测试临时目录与产物（含远程测试生成物）
.verify*/
.verify/
.verify-compose/
.verify-dist/
scripts/remote-*.mjs
scripts/remote.mjs
scripts/mcp-remote-*.mjs
scripts/remote-verify.sh
scripts/remote-compose-verify.sh
scripts/remote-dist-test.sh
screenshot*.png

# doc/ 目录策略：仅允许 README 展示用图片上传（产品策略：doc 只保留截图/图片）
doc/**
!doc/
!doc/*.png
!doc/*.jpg
!doc/*.jpeg
!doc/*.gif
!doc/*.webp
!doc/*.svg
# 例外：审计/验证文档与实测截图仍然严禁上传（规则第九条）
doc/test-*.png
doc/test-*.jpg
doc/verification-report.md
doc/upstream-contract.md

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
