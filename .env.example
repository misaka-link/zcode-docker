# ========================================================
# zcode-docker 环境变量配置文件模板 (.env)
# 契约规范参考: doc/api-contract.md §2
# ========================================================

# --------------------------------------------------------
# 0. 镜像选择（仅 docker-compose 使用）
# --------------------------------------------------------

# compose 使用的镜像。默认拉取已发布的 GHCR 镜像；
# 想用本地构建的镜像时，先执行 ./build.sh（默认打 ghcr.io/misaka-link/zcode-docker 标签），
# 或把下面这行改成 ZCODE_IMAGE=zcode-docker:latest。
# ZCODE_IMAGE=ghcr.io/misaka-link/zcode-docker:latest

# --------------------------------------------------------
# 1. 访问安全与身份认证
# --------------------------------------------------------

# 访问认证口令 (Access Code)
# 浏览器访问 Web 工作区、管理控制台 (/admin) 和虚拟桌面 (/vnc) 时的统一认证口令。
# 留空（推荐）：首次启动访问将自动进入「初始化访问口令」向导，设置后以 0600 权限持久化至数据卷。
# 显式填写：跳过向导直接使用该口令（生产环境请务必使用强口令，切勿使用 admin/123456 等弱口令）。
AUTH_TOKEN=

# Session 会话签名密钥 (可选)
# 留空时系统将在首次启动时自动生成高强度随机密钥并持久化保存。
# 如需多节点集群共享会话或手动指定，可取消注释配置：
# SESSION_SECRET=your_custom_long_random_secret_here

# --------------------------------------------------------
# 2. 网络端口与代理配置
# --------------------------------------------------------

# 统一对外访问端口 (默认 3080)
# 显式设置时优先于数据卷中的持久化配置，并决定 docker-compose 宿主机端口映射。
PROXY_PORT=3080

# 是否信任反向代理转发的 X-Forwarded-For 标头（默认 0）
# 仅当容器部署在受信的反向代理（如 Nginx、Caddy、Traefik）后端时才设为 1，以保证登录防爆破限流有效。
# TRUST_PROXY=0

# 对外主机名白名单（逗号分隔，用于 WebSocket 同源校验）
# 例如: PUBLIC_HOST=zcode.example.com,dev.zcode.local
# PUBLIC_HOST=

# --------------------------------------------------------
# 3. 访问路径与目录配置
# --------------------------------------------------------

# 管理控制台访问路径 (默认 /admin)
# ADMIN_PATH=/admin

# 虚拟桌面 VNC 访问路径 (默认 /vnc)
# VNC_PATH=/vnc

# 运行根目录 (默认 /root，非 root 部署可设为 /home/zcode)
# ZCODE_HOME=/root

# AI 编程工作区目录 (容器内路径)
# ZCODE_WORKSPACE=/workspace

# ZCode Web「添加项目」目录浏览器的默认起始目录 (默认 /workspace)
# ZCODE_BROWSE_ROOT=/workspace

# --------------------------------------------------------
# 4. 虚拟桌面与浏览器环境
# --------------------------------------------------------

# 是否启用虚拟桌面功能 (1: 开启, 0: 关闭，默认 1)
ZCODE_DESKTOP_ENABLED=1

# 虚拟桌面运行模式 (browser: 容器 Chromium 浏览器; client: Electron 客户端)
ZCODE_DESKTOP_MODE=browser

# 虚拟桌面分辨率与色彩深度
ZCODE_DESKTOP_WIDTH=1920
ZCODE_DESKTOP_HEIGHT=1080
ZCODE_DESKTOP_DEPTH=24

# 虚拟桌面空闲自动休眠时间 (单位：分钟，0 表示不休眠始终保持运行)
ZCODE_IDLE_TIMEOUT_MINUTES=30

# AI 截图默认画质 (high: 无损原图, medium: 平衡, low: 极度压缩)
ZCODE_SCREENSHOT_QUALITY=high

# AI 截图默认保存子目录 (相对工作区路径，留空表示工作区根目录)
# ZCODE_SCREENSHOT_DIR=

# 浏览器用户数据目录 (Cookies / 登录态)
# CHROME_USER_DATA_DIR=/root/.config/chromium

# Chromium 远程调试 (CDP) 端口 (browser 模式，默认 9222；关闭 CDP 后 AI 截图/操作不可用)
# ZCODE_CDP_PORT=9222
# ZCODE_ENABLE_CDP=1

# x11vnc 的 RFB 端口 (默认 5900；同机多实例或端口冲突时可改)
# ZCODE_VNC_RFB_PORT=5900

# browser 模式 Chromium 起始页面（默认留空，打开 about:blank 空白页）
# 取值支持：
#   - 留空 / 未设置: 打开 about:blank 干净空窗口（默认）
#   - zcode 或 zcode-web: 打开容器内 ZCode Web（http://127.0.0.1:3030/）
#   - http:// 或 https:// 开头的任意地址: 原样打开
#   - about:blank: 空白页
# ZCODE_DESKTOP_START_URL=

# browser 模式是否以 app/kiosk 形态全屏启动（1 开启，0 普通窗口，默认 0；仅当启动地址非 about:blank 时生效）
# ZCODE_DESKTOP_KIOSK=0

# client 模式使用的 ZCode 桌面客户端可执行文件 (留空则自动探测 /opt/zcode-desktop)
# ZCODE_CLIENT_BIN=

# noVNC 静态资源版本号 (需与镜像内 /usr/share/novnc/novnc-<rev> 一致，默认 1.6.0)
# NOVNC_ASSET_REVISION=1.6.0

# --------------------------------------------------------
# 5. 版本分发与多版本管理
# --------------------------------------------------------

# 运行时在线版本分发基址 (留空则禁用管理后台在线下载安装版本)
# 例如: ZCODE_DIST_URL=https://my-dist-server.internal/zcode
# ZCODE_DIST_URL=

# 运行时版本切换前最小磁盘剩余空间水位要求 (MB，默认 1536)
# ZCODE_VERSIONS_MIN_FREE_MB=1536

# 上游内部通信令牌注入开关 (0: 上游 --no-token; 1: 网关自动生成内部令牌并注入)
# ZCODE_INTERNAL_TOKEN=0

# --------------------------------------------------------
# 6. 出站网络代理 (按需配置)
# 模型 API 调用、外部网页获取或依赖下载走代理通道
# --------------------------------------------------------
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# ALL_PROXY=socks5://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,zcode
